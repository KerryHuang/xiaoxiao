{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xiaoxiao",
  "version": "0.2.0",
  "identifier": "io.github.kerryhuang.xiaoxiao",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "小小",
        "width": 520,
        "height": 680,
        "visible": false,
        "resizable": true
      },
      {
        "label": "character",
        "create": false,
        "title": "小小",
        "url": "character.html",
        "width": 96,
        "height": 96,
        "visible": false,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "macOS": {
      "frameworks": [
        "../models/sherpa-onnx-lib/lib/libsherpa-onnx-c-api.dylib",
        "../models/sherpa-onnx-lib/lib/libonnxruntime.dylib"
      ],
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "category": "Productivity",
    "shortDescription": "日常語音助理小小"
  }
}
